{
  "rev3_turn": "-ts_delta(close, 3) / close * cs_rank(turnover)",
  "rev5_turn": "-ts_delta(close, 5) / close * cs_rank(turnover)",
  "rev4_turn_highpos": "-ts_delta(close, 4) / close * cs_rank(turnover) * ((close - ts_min(close, 20)) / (ts_max(close, 20) - ts_min(close, 20)))",
  "rev4_turn_nearhigh": "-ts_delta(close, 4) / close * cs_rank(turnover) * cs_rank(close / ts_max(high, 20))",
  "rev4_turn_lowdist10": "-ts_delta(close, 4) / close * cs_rank(turnover) * cs_rank(close / ts_min(low, 10))",
  "rev4_turn_lowdist60": "-ts_delta(close, 4) / close * cs_rank(turnover) * cs_rank(close / ts_min(low, 60))",
  "rev4_turn_lowdist_rk20": "-ts_delta(close, 4) / close * cs_rank(turnover) * cs_rank(close / ts_min(low, 20) - 1)",
  "rev5_turn_lowdist": "-ts_delta(close, 5) / close * cs_rank(turnover) * cs_rank(close / ts_min(low, 20))",
  "rev3_turn_lowdist": "-ts_delta(close, 3) / close * cs_rank(turnover) * cs_rank(close / ts_min(low, 20))",
  "rev4_turn_lowdist_z": "-ts_delta(close, 4) / close * cs_rank(turnover) * cs_scale(close / ts_min(low, 20))",
  "rev4_turn_lowdist_half": "-ts_delta(close, 4) / close * cs_rank(turnover) * (0.5 + 0.5 * cs_rank(close / ts_min(low, 20)))",
  "rev4_amp5": "-ts_delta(close, 4) / close * cs_rank(ts_mean((high - low) / close, 5))"
}
